/* === Estilo general === */
QMainWindow {
    background-color: #121212;
    color: #e0e0e0;
}

/* === Barra de menú === */
QMenuBar {
    background-color: #181818;
    color: #e0e0e0;
}
QMenuBar::item:selected {
    background-color: #282828;
}
QMenu {
    background-color: #181818;
    color: #e0e0e0;
    border: 1px solid #303030;
}
QMenu::item:selected {
    background-color: #333333;
}

/* === Botones === */
QPushButton {
    background-color: #1db954; /* verde Spotify */
    color: white;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #1ed760;
}
QPushButton:pressed {
    background-color: #169c46;
}
QPushButton:disabled {
    background-color: #404040;
    color: #777;
}

/* === Slider de volumen o progreso === */
QSlider::groove:horizontal {
    height: 6px;
    background: #303030;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #1db954;
    border: none;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin: -4px 0;
}
QSlider::sub-page:horizontal {
    background: #1db954;
}

/* === Lista de reproducción === */
QListWidget {
    background-color: #181818;
    color: #e0e0e0;
    border: 1px solid #282828;
    border-radius: 6px;
}
QListWidget::item:selected {
    background-color: #1db954;
    color: white;
}

/* === Etiquetas (labels) === */
QLabel {
    color: #e0e0e0;
}

/* === Barra de progreso === */
QProgressBar {
    border: 1px solid #303030;
    border-radius: 5px;
    background: #181818;
    height: 10px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #1db954;
    border-radius: 5px;
}

/* === Campos de texto === */
QLineEdit {
    background-color: #222;
    border: 1px solid #444;
    border-radius: 6px;
    color: #e0e0e0;
    padding: 4px 6px;
}
QLineEdit:focus {
    border: 1px solid #1db954;
}

/* === ScrollBars === */
QScrollBar:vertical {
    background: #181818;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #444;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #666;
}