/* ================= TEMA OSCURO ================= */

/* Fondo general */
QMainWindow, QWidget#centralwidget, QWidget {
    background-color: #2E2E2E;
    color: #F0F0F0;
}

/* QMenuBar */
QMenuBar {
    background-color: #1A1A1A;
    color: #F0F0F0;
}
QMenuBar::item:selected {
    background-color: #333333;
}

/* Menús desplegables */
QMenu {
    background-color: #1A1A1A;
    color: #F0F0F0;
}
QMenu::item:selected {
    background-color: #333333;
}

/* Botones principales */
QPushButton {
    background-color: #404040;
    /* TRUCO: Borde de 1px presente (aunque sea oscuro) para igualar al tema claro */
    border: 1px solid #555555;
    border-radius: 8px;
    /* CORRECCIÓN: Mismo padding que el tema claro */
    padding: 2px;
}
QPushButton:hover {
    background-color: #505050;
    border: 1px solid #666666;
}
QPushButton:pressed {
    background-color: #303030;
}
QPushButton:disabled {
    background-color: #2A2A2A;
    border: 1px solid #333333;
    color: #555555;
}

/* Labels */
QLabel {
    color: #F0F0F0;
}

/* Sliders */
QSlider::groove:horizontal {
    border: 1px solid #555555;
    height: 8px;
    background: #404040;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: #808080;
    border: 1px solid #555555;
    width: 16px;
    margin: -4px 0;
    border-radius: 8px;
}

/* Lista de reproducción */
QListWidget {
    background-color: #1A1A1A;
    border: 1px solid #555555;
    color: #F0F0F0;
    /* CORRECCIÓN CRÍTICA: Copiamos exactamente las medidas del tema claro */
    min-width: 300px;
    max-width: 300px;
}

/* Video widget */
QVideoWidget {
    background-color: #000000;
}