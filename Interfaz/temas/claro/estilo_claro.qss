/* ================= TEMA CLARO ================= */

/* Fondo general */
QMainWindow, QWidget#centralwidget, QWidget {
    background-color: #F0F0F0;
    color: #2E2E2E;
}

/* QMenuBar */
QMenuBar {
    background-color: #E0E0E0;
    color: #2E2E2E;
}
QMenuBar::item:selected {
    background-color: #D0D0D0;
}

/* Menús desplegables */
QMenu {
    background-color: #E0E0E0;
    color: #2E2E2E;
}
QMenu::item:selected {
    background-color: #C0C0C0;
}

/* Botones principales */
QPushButton {
    background-color: #FFFFFF;
    /* Borde de 1px visible */
    border: 1px solid #B0B0B0;
    border-radius: 8px;
    /* CORRECCIÓN: Padding reducido para que quepa el icono de 90px */
    padding: 2px;
}
QPushButton:hover {
    background-color: #E5E5E5;
}
QPushButton:pressed {
    background-color: #CCCCCC;
}
QPushButton:disabled {
    background-color: #F0F0F0;
    border: 1px solid #D0D0D0;
    color: #A0A0A0;
}

/* Labels */
QLabel {
    color: #2E2E2E;
}

/* Sliders */
QSlider::groove:horizontal {
    border: 1px solid #B0B0B0;
    height: 8px;
    background: #D0D0D0;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 1px solid #A0A0A0;
    width: 16px;
    margin: -4px 0;
    border-radius: 8px;
}

/* Lista de reproducción */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #B0B0B0;
    color: #2E2E2E;
    /* CORRECCIÓN: Dimensiones fijas obligatorias */
    min-width: 300px;
    max-width: 300px;
}

/* Video widget */
QVideoWidget {
    background-color: #000000;
}